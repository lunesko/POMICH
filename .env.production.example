VITE_APP_NAME=POMICH
VITE_APP_ENV=production
VITE_APP_VERSION=0.1.0

# Runtime mode. Production enables config guards during FastAPI startup.
POMICH_RUNTIME=production

# Use exact public HTTPS origins only. Do not use * in production.
POMICH_CORS_ORIGINS=https://app.example.com

# Backend-only admin secret. Send as X-POMICH-Admin-Token until role-based auth replaces this.
POMICH_ADMIN_TOKEN=change-this-to-a-long-random-admin-secret

# Backend-only partner secret. Required in production so partner endpoints are not public.
POMICH_PROVIDER_TOKEN=change-this-to-a-long-random-provider-secret

# Backend-only Telegram token. Do not expose this with a VITE_ prefix.
TELEGRAM_BOT_TOKEN=

# Use webhook for a hosted public deployment; polling is fine only for local development.
TELEGRAM_MODE=webhook

# Public HTTPS URL for the Telegram Mini App.
WEB_APP_URL=https://app.example.com

# Preferred release storage. Use postgresql:// or postgresql+psycopg://.
POMICH_STORAGE_BACKEND=sql
POSTGRES_DB=pomich
POSTGRES_USER=pomich
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://pomich:change-this-db-password@postgres:5432/pomich

# JSON-store fallback paths for local/demo mode only. In production without DATABASE_URL,
# set POMICH_ALLOW_JSON_STORE_IN_PRODUCTION=true deliberately for a very small pilot.
# POMICH_ALLOW_JSON_STORE_IN_PRODUCTION=false
POMICH_ORDER_STORE_PATH=/app/data/orders.json
POMICH_PROVIDER_STORE_PATH=/app/data/providers.json
POMICH_CUSTOMER_STORE_PATH=/app/data/customers.json
POMICH_OFFER_STORE_PATH=/app/data/offers.json
POMICH_SESSION_STORE_PATH=/app/data/telegram_sessions.json
