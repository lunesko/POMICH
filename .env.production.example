VITE_APP_NAME=POMICH
VITE_APP_ENV=production
VITE_APP_VERSION=0.1.0

# Runtime mode. Production enables config guards during FastAPI startup.
POMICH_RUNTIME=production

# Use exact public HTTPS origins only. Do not use * in production.
POMICH_CORS_ORIGINS=https://pomich.help

# Backend-only admin bootstrap secret. Use it to create an admin session; do not expose it in the frontend.
POMICH_ADMIN_TOKEN=change-this-to-a-long-random-admin-secret

# Backend-only provider bootstrap secret. Use it to create provider sessions; do not expose it in the frontend.
POMICH_PROVIDER_TOKEN=change-this-to-a-long-random-provider-secret

# Backend-only customer session signing secret. Do not expose it in the frontend.
POMICH_CUSTOMER_SESSION_SECRET=change-this-to-a-long-random-customer-secret

# Provider/admin account login seeds for the beta. Prefer passwordHash=sha256:<hex> over plaintext.
POMICH_ADMIN_ACCOUNTS=[{"username":"dispatcher","passwordHash":"sha256:replace-with-sha256-password-hash"}]
POMICH_PROVIDER_ACCOUNTS=[{"providerId":"provider-oleksandr","username":"oleksandr","passwordHash":"sha256:replace-with-sha256-password-hash"}]

# Backend-only Telegram secrets. Do not expose these with a VITE_ prefix.
# TELEGRAM_BOT_TOKEN is kept only as a backward-compatible single-bot fallback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CUSTOMER_BOT_USERNAME=pomich_ua_bot
TELEGRAM_CUSTOMER_BOT_TOKEN=change-this-customer-bot-token
TELEGRAM_CUSTOMER_WEB_APP_URL=https://pomich.help/?role=customer&tgBot=customer
TELEGRAM_PROVIDER_BOT_USERNAME=pomich_help_bot
TELEGRAM_PROVIDER_BOT_TOKEN=change-this-provider-bot-token
TELEGRAM_PROVIDER_WEB_APP_URL=https://pomich.help/?role=provider&tgBot=provider

# Use webhook for a hosted public deployment; polling is fine only for local development.
TELEGRAM_MODE=webhook

# Public HTTPS URL for the Telegram Mini App.
WEB_APP_URL=https://pomich.help

# SMTP for email OTP verification.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change-this-smtp-password
SMTP_FROM=POMICH <noreply@example.com>
SMTP_USE_TLS=true

# Optional dedicated OTP hashing secret (defaults to POMICH_CUSTOMER_SESSION_SECRET).
POMICH_OTP_SECRET=

# Preferred release storage. Use postgresql:// or postgresql+psycopg://.
POMICH_STORAGE_BACKEND=sql
POSTGRES_DB=pomich
POSTGRES_USER=pomich
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://pomich:change-this-db-password@postgres:5432/pomich

# JSON-store fallback paths for local/demo mode only. In production without DATABASE_URL,
# set POMICH_ALLOW_JSON_STORE_IN_PRODUCTION=true deliberately for a very small pilot.
# POMICH_ALLOW_JSON_STORE_IN_PRODUCTION=false
POMICH_ORDER_STORE_PATH=/app/data/orders.json
POMICH_PROVIDER_STORE_PATH=/app/data/providers.json
POMICH_CUSTOMER_STORE_PATH=/app/data/customers.json
POMICH_OFFER_STORE_PATH=/app/data/offers.json
POMICH_SESSION_STORE_PATH=/app/data/telegram_sessions.json
