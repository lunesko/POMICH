VITE_APP_NAME=POMICH
VITE_APP_ENV=local
VITE_APP_VERSION=0.1.0

# Local development can use short demo secrets. Production must set POMICH_RUNTIME=production.
POMICH_RUNTIME=dev

# Local development defaults to JSON files. Set DATABASE_URL to use SQL runtime storage.
POMICH_STORAGE_BACKEND=json
DATABASE_URL=

# Comma-separated browser origins allowed to call the API. Use exact HTTPS origins in production.
POMICH_CORS_ORIGINS=*

# Backend-only admin bootstrap secret. Send as X-POMICH-Admin-Token to create an admin session.
POMICH_ADMIN_TOKEN=replace-me-admin-token

# Backend-only provider bootstrap secret. Partner endpoints require auth even in local dev.
POMICH_PROVIDER_TOKEN=local-provider-secret

# Backend-only customer session signing secret. Production must set a long random value.
POMICH_CUSTOMER_SESSION_SECRET=local-customer-session-secret

# Optional local account login seeds. Use JSON arrays; production should use long passwords or passwordHash=sha256:<hex>.
# POMICH_ADMIN_ACCOUNTS=[{"username":"dispatcher","password":"admin-pass"}]
# POMICH_PROVIDER_ACCOUNTS=[{"providerId":"provider-oleksandr","username":"oleksandr","password":"provider-pass"}]

# Backend-only secret. Do not expose this with a VITE_ prefix.
TELEGRAM_BOT_TOKEN=123456:replace-me

# Local development uses polling because Telegram cannot call localhost webhooks.
TELEGRAM_MODE=polling

# Optional. Use only a public HTTPS URL when the Mini App is exposed through a tunnel or deployment.
WEB_APP_URL=
