VITE_APP_NAME=POMICH
VITE_APP_ENV=local
VITE_APP_VERSION=0.1.0

# Local development mode keeps provider token optional. Production must set POMICH_RUNTIME=production.
POMICH_RUNTIME=dev

# Local development defaults to JSON files. Set DATABASE_URL to use SQL runtime storage.
POMICH_STORAGE_BACKEND=json
DATABASE_URL=

# Comma-separated browser origins allowed to call the API. Use exact HTTPS origins in production.
POMICH_CORS_ORIGINS=*

# Backend-only admin secret. Send as X-POMICH-Admin-Token.
POMICH_ADMIN_TOKEN=replace-me-admin-token

# Optional locally. Required in production. When set, partner endpoints require X-POMICH-Provider-Token.
POMICH_PROVIDER_TOKEN=

# Backend-only secret. Do not expose this with a VITE_ prefix.
TELEGRAM_BOT_TOKEN=123456:replace-me

# Local development uses polling because Telegram cannot call localhost webhooks.
TELEGRAM_MODE=polling

# Optional. Use only a public HTTPS URL when the Mini App is exposed through a tunnel or deployment.
WEB_APP_URL=
